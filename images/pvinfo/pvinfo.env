# EPICS Lab overrides for PV Info (loaded as .env.local at build time;
# see the full option list in the pvinfo repo's .env).

REACT_APP_WEBSITE_NAME=EPICS Lab PV Info
REACT_APP_WEBSITE_DESC=EPICS Lab PV directory
REACT_APP_ENDPOINT=/pvinfo
REACT_APP_DOMAIN=localhost
REACT_APP_HTTP_PROTOCOL=http

# ChannelFinder, via the same-origin nginx proxy (no CORS needed)
REACT_APP_CF_URL=/ChannelFinder
REACT_APP_CF_RECORD_TYPE=true
REACT_APP_CF_RECORD_DESC=true
REACT_APP_CF_ALIAS=true

# Searchable extra property: the archive intent declared via db info() tags
REACT_APP_EXTRA_PROP=archive
REACT_APP_EXTRA_PROP_LABEL=Archived
REACT_APP_EXTRA_PROP_HELP_TEXT=sampling method@period, e.g. monitor@1.0
REACT_APP_EXTRA_PROP_SHOW_IN_RESULTS=true

# Archiver Appliance viewer, via the nginx proxy
REACT_APP_USE_AA=true
REACT_APP_AA_URL=/retrieval/ui/viewer/archViewer.html
REACT_APP_AA_POLICIES=

# Services this stack does not run (yet)
REACT_APP_USE_PVWS=false
REACT_APP_USE_OLOG=false
REACT_APP_USE_AL=false
REACT_APP_USE_CAPUTLOG=false

# Help / branding
REACT_APP_HELP_EXAMPLE_PV=LAB:CRYO:TC1:TEMP
REACT_APP_HELP_PV_NAMING_CONVENTION="LAB:<AREA>:<DEVICE><N>:<SIGNAL> — e.g. LAB:CRYO:TC1:TEMP (see docs/naming-conventions.md)"
REACT_APP_HOMEPAGE_HEADER="Search and inspect EPICS Lab PVs and their metadata via ChannelFinder"
REACT_APP_HOMEPAGE_SUBHEADER="Populated automatically by RecSync; archive links via the Archiver Appliance"
