<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>Vacuum</name>
  <width>640</width>
  <height>320</height>
  <widget type="label" version="2.0.0">
    <text>Vacuum</text>
    <x>20</x><y>15</y><width>300</width><height>30</height>
    <font>
      <font family="Liberation Sans" style="BOLD" size="20"/>
    </font>
  </widget>

  <widget type="group" version="2.0.0">
    <name>Chamber</name>
    <x>20</x><y>60</y><width>290</width><height>200</height>
    <widget type="label" version="2.0.0">
      <text>Pressure</text>
      <x>10</x><y>10</y><width>110</width><height>20</height>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <pv_name>LAB:VAC:GA1:PRES</pv_name>
      <x>130</x><y>10</y><width>110</width><height>20</height>
      <format>2</format>
      <show_units>true</show_units>
    </widget>
    <widget type="label" version="2.0.0">
      <text>Interlock OK</text>
      <x>10</x><y>40</y><width>110</width><height>20</height>
    </widget>
    <widget type="led" version="2.0.0">
      <pv_name>LAB:VAC:ILK:OK</pv_name>
      <x>130</x><y>40</y><width>20</width><height>20</height>
    </widget>
    <widget type="label" version="2.0.0">
      <text>Gate valve</text>
      <x>10</x><y>70</y><width>110</width><height>20</height>
    </widget>
    <widget type="led" version="2.0.0">
      <pv_name>LAB:VAC:VLV1:STS</pv_name>
      <x>130</x><y>70</y><width>20</width><height>20</height>
    </widget>
    <widget type="action_button" version="3.0.0">
      <actions>
        <action type="write_pv">
          <pv_name>LAB:VAC:VLV1:CMD</pv_name>
          <value>1</value>
          <description>Open valve</description>
        </action>
      </actions>
      <text>Open valve</text>
      <x>10</x><y>110</y><width>100</width><height>30</height>
    </widget>
    <widget type="action_button" version="3.0.0">
      <actions>
        <action type="write_pv">
          <pv_name>LAB:VAC:VLV1:CMD</pv_name>
          <value>0</value>
          <description>Close valve</description>
        </action>
      </actions>
      <text>Close valve</text>
      <x>130</x><y>110</y><width>100</width><height>30</height>
    </widget>
    <widget type="label" version="2.0.0">
      <text>Valve closes automatically above 1e-4 mbar</text>
      <x>10</x><y>155</y><width>260</width><height>30</height>
      <font>
        <font family="Liberation Sans" style="ITALIC" size="11"/>
      </font>
    </widget>
  </widget>

  <widget type="group" version="2.0.0">
    <name>Turbo pump</name>
    <x>330</x><y>60</y><width>290</width><height>200</height>
    <widget type="label" version="2.0.0">
      <text>Speed</text>
      <x>10</x><y>10</y><width>110</width><height>20</height>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <pv_name>LAB:VAC:PMP1:SPEED</pv_name>
      <x>130</x><y>10</y><width>110</width><height>20</height>
      <show_units>true</show_units>
    </widget>
    <widget type="progressbar" version="2.0.0">
      <pv_name>LAB:VAC:PMP1:SPEED</pv_name>
      <x>10</x><y>40</y><width>230</width><height>20</height>
    </widget>
    <widget type="action_button" version="3.0.0">
      <actions>
        <action type="write_pv">
          <pv_name>LAB:VAC:PMP1:RUN</pv_name>
          <value>1</value>
          <description>Start pump</description>
        </action>
      </actions>
      <text>Start pump</text>
      <x>10</x><y>80</y><width>100</width><height>30</height>
    </widget>
    <widget type="action_button" version="3.0.0">
      <actions>
        <action type="write_pv">
          <pv_name>LAB:VAC:PMP1:RUN</pv_name>
          <value>0</value>
          <description>Stop pump</description>
        </action>
      </actions>
      <text>Stop pump</text>
      <x>130</x><y>80</y><width>100</width><height>30</height>
    </widget>
  </widget>
</display>
