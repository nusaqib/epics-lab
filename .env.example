# Copy to `.env` and adjust. Every variable has a working default for local
# development; change the passwords before exposing the stack beyond localhost.

# Image tag applied to locally built images.
EPICS_LAB_TAG=dev

# Archiver Appliance configuration database (MariaDB).
ARCHAPPL_DB_PASSWORD=archappl
ARCHAPPL_DB_ROOT_PASSWORD=archappl-root

# Hostname that host-side clients (e.g. Phoebus on your desktop) use to reach
# Kafka. Change to this machine's DNS name if clients run on other machines.
KAFKA_EXTERNAL_HOST=localhost

# Grafana admin password (monitoring profile).
GRAFANA_ADMIN_PASSWORD=admin

# Upstream image versions.
KAFKA_VERSION=3.7.0
MARIADB_VERSION=10.11
ELASTICSEARCH_VERSION=8.11.4
PROMETHEUS_VERSION=v2.53.0
GRAFANA_VERSION=11.1.0
